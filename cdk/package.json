{
  "name": "fip-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "FIP v2 — Forensic Isolation Program for AWS EC2: contain, acquire and attest evidence. CDK app and the fip CLI.",
  "main": "bin/fip-app.js",
  "bin": {
    "fip-app": "bin/fip-app.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "synth": "cdk synth",
    "synth:core": "cdk synth FipCoreStack",
    "synth:member": "cdk synth FipMemberStack",
    "diff:core": "cdk diff FipCoreStack",
    "deploy:core": "cdk deploy FipCoreStack",
    "nag": "cdk synth --context fip:nag=true --quiet"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.150.0",
    "cdk-nag": "^2.28.0"
  }
}
