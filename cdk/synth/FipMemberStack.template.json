       "Action": "sts:AssumeRole",
       "Condition": {
        "StringEquals": {
         "sts:ExternalId": {
          "Ref": "ExternalId"
         }
        }
       },
       "Effect": "Allow",
       "Principal": {
        "AWS": {
         "Fn::Join": [
          "",
          [
           "arn:",
           {
            "Ref": "AWS::Partition"
           },
           ":iam::",
           {
            "Ref": "OrchestratorAccountId"
           },
           ":root"
          ]
         ]
        }
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "Description": "FIP read-only inventory. Assumed constantly; can change nothing.",
    "RoleName": "FipInventoryRole",
    "Tags": [
     {
      "Key": "application",
      "Value": "fipv2"
     },
     {
      "Key": "fip:class",
      "Value": "infrastructure"
     },
     {
      "Key": "fip:component",
      "Value": "member"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "FipMemberStack/FipInventoryRole/Resource"
   }
  },
