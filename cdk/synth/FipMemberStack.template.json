{
 "Description": "FIP member-account payload — FipInventoryRole (read-only) only",
 "Parameters": {
  "OrchestratorAccountId": {
   "Type": "String",
   "AllowedPattern": "^[0-9]{12}$",
   "ConstraintDescription": "Must be a 12-digit AWS account ID.",
   "Description": "Account ID of the FIP orchestrator, the only principal permitted to assume this role."
  },
  "EvidenceAccountId": {
   "Type": "String",
   "AllowedPattern": "^[0-9]{12}$",
   "ConstraintDescription": "Must be a 12-digit AWS account ID.",
   "Description": "Account ID holding the FIP evidence bucket and forensic CMK. The only account this role may grant access to the member key."
  },
  "ExternalId": {
   "Type": "String",
   "AllowedPattern": "^[A-Za-z0-9+=,.@:/-]{16,1224}$",
   "ConstraintDescription": "At least 16 characters, alphanumeric plus + = , . @ : / - and no spaces.",
   "Description": "Unpredictable per-account identifier issued by the FIP orchestrator operator, required on sts:AssumeRole. Not a secret — it is visible in this role trust policy. Do not invent your own value; use the one you were issued, or the confused-deputy protection it provides is void."
  },
  "DeployResponderRole": {
   "Type": "String",
   "Default": "Yes",
   "AllowedValues": [
    "Yes",
    "No"
   ],
   "Description": "Deploy the mutating FipResponderRole. Choose No to grant read-only inventory now and activate response capability later."
  },
  "AllowRestore": {
   "Type": "String",
   "Default": "Yes",
   "AllowedValues": [
    "Yes",
    "No"
   ],
   "Description": "Let FIP restore a contained instance to its original security groups (fip restore). No keeps restore a manual step with this account's own credentials."
  }
 },
 "Resources": {
  "FipInventoryRole33FBE6B1": {
   "Type": "AWS::IAM::Role",
